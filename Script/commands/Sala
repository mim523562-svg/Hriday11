const axios = require("axios");
const fs = require("fs-extra");
const path = require("path");
const { createCanvas, loadImage } = require("canvas");

module.exports.config = {
  name: "sala",
  version: "2.0.0",
  hasPermssion: 0,
  credits: "HRIDOY HASAN SHANTO",
  description: "SALA banner with random Bangla caption",
  commandCategory: "banner",
  usePrefix: true,
  usages: "sala @mention | reply",
  cooldowns: 40,
  dependencies: {
    axios: "",
    "fs-extra": "",
    canvas: ""
  }
};

// ================= SETTINGS =================

const TEMPLATE_URL = "https://i.imgur.com/vxfoQt2.jpeg";

const REF_W = 1536;
const REF_H = 1024;

// বাম পাশে টার্গেট, ডান পাশে কমান্ডদাতা
const LEFT = { x: 265, y: 359, rx: 133, ry: 130 };
const RIGHT = { x: 1352, y: 361, rx: 125, ry: 127 };

const TEXTS = [
  "সালা 😂 তোর ছোটবেলার বন্ধুর বিয়ে হয়ে গেল! 💍🤣\nপুরোনো কাহিনি এবার বউয়ের কাছে ফাঁস হবে! 🤭🔥",
  "সালা 😂 ছোটবেলার বন্ধু আজ বিয়ে করে পুরাই বউয়ের গোলাম! 🤣💍\nআগের দুষ্টুমি ভুলে এখন বউয়ের ভয়ে চুপচাপ! 🙈",
  "সালা 🤣 বন্ধুর বিয়ে দেখে পুরোনো দিনের কথা মনে পড়ে! 💍😂\nএবার তোর সব গোপন কাহিনি ফাঁস হবে! 🤫🔥",
  "সালা 😜 বন্ধুত্ব থেকে জামাই-বন্ধু! 😂💍\nআমরা আড্ডা দিই, আর তুই বউ নিয়ে ব্যস্ত! 🤣❤️",
  "সালা 😂 বন্ধুর বিয়েতে আনন্দের শেষ নেই! 💍🥳\nছোটবেলার দুষ্টুমির গল্প কিন্তু এখনো বাকি! 🤭🤣"
];

const CACHE_DIR = path.join(__dirname, "cache");
const TEMPLATE_PATH = path.join(CACHE_DIR, "sala_template.jpg");

// ================= HELPERS =================

async function downloadImage(url, timeout = 25000) {
  const response = await axios.get(url, {
    responseType: "arraybuffer",
    timeout,
    maxRedirects: 5,
    headers: {
      "User-Agent": "Mozilla/5.0"
    }
  });

  const buffer = Buffer.from(response.data);

  if (!buffer.length) {
    throw new Error("ছবির ডেটা খালি এসেছে");
  }

  return buffer;
}

async function getTemplate() {
  // পুরোনো ক্যাশ নষ্ট হলে মুছে আবার ডাউনলোড
  if (await fs.pathExists(TEMPLATE_PATH)) {
    try {
      return await loadImage(TEMPLATE_PATH);
    } catch {
      await fs.remove(TEMPLATE_PATH);
    }
  }

  const buffer = await downloadImage(TEMPLATE_URL);
  const image = await loadImage(buffer);

  await fs.writeFile(TEMPLATE_PATH, buffer);
  return image;
}

async function getAvatar(uid) {
  // কোনো embedded access token ব্যবহার করা হচ্ছে না
  const url =
    `https://graph.facebook.com/${encodeURIComponent(uid)}/picture` +
    "?width=720&height=720";

  const buffer = await downloadImage(url);
  return await loadImage(buffer);
}

function drawAvatar(ctx, image, frame, sx, sy) {
  const cx = frame.x * sx;
  const cy = frame.y * sy;
  const rx = frame.rx * sx;
  const ry = frame.ry * sy;

  const width = rx * 2;
  const height = ry * 2;

  // ছবি বিকৃত না করে মাঝখান থেকে crop
  const scale = Math.max(
    width / image.width,
    height / image.height
  );

  const drawWidth = image.width * scale;
  const drawHeight = image.height * scale;

  ctx.save();
  ctx.beginPath();
  ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
  ctx.clip();

  ctx.drawImage(
    image,
    cx - drawWidth / 2,
    cy - drawHeight / 2,
    drawWidth,
    drawHeight
  );

  ctx.restore();
}

function getTargetID(event) {
  const mentions = event.mentions || {};
  const mentionIDs = Object.keys(mentions);

  if (mentionIDs.length > 0) {
    return mentionIDs[0];
  }

  if (event.messageReply && event.messageReply.senderID) {
    return event.messageReply.senderID;
  }

  return null;
}

// ================= MAIN COMMAND =================

module.exports.run = async function ({ api, event }) {
  const { threadID, messageID, senderID } = event;
  const targetID = getTargetID(event);

  if (!targetID) {
    return api.sendMessage(
      "⚠️ আগে কাউকে মেনশন করো অথবা তার মেসেজে রিপ্লাই দাও!\n\n" +
      "উদাহরণ: sala @নাম\n" +
      "অথবা কারও মেসেজে রিপ্লাই দিয়ে sala লেখো।",
      threadID,
      messageID
    );
  }

  if (String(targetID) === String(senderID)) {
    // নিজের ছবিও ব্যবহার করা যাবে
  }

  let outputPath;

  try {
    await fs.ensureDir(CACHE_DIR);

    // প্রতিবার আলাদা ফাইল, যাতে একই সময়ে একাধিক কমান্ডে সংঘর্ষ না হয়
    outputPath = path.join(
      CACHE_DIR,
      `sala_${Date.now()}_${Math.random()
        .toString(36).slice(2, 9)}.png`
    );

    // সব ছবি একসঙ্গে লোড
    const [template, targetAvatar, senderAvatar] =
      await Promise.all([
        getTemplate(),
        getAvatar(targetID),
        getAvatar(senderID)
      ]);

    const width = template.width;
    const height = template.height;

    const sx = width / REF_W;
    const sy = height / REF_H;

    const canvas = createCanvas(width, height);
    const ctx = canvas.getContext("2d");

    // Template background
    ctx.drawImage(template, 0, 0, width, height);

    // বামে মেনশন/রিপ্লাই করা ব্যক্তি
    drawAvatar(ctx, targetAvatar, LEFT, sx, sy);

    // ডানে কমান্ডদাতা
    drawAvatar(ctx, senderAvatar, RIGHT, sx, sy);

    await fs.writeFile(outputPath, canvas.toBuffer("image/png"));

    const caption =
      TEXTS[Math.floor(Math.random() * TEXTS.length)];

    return api.sendMessage(
      {
        body: caption,
        attachment: fs.createReadStream(outputPath)
      },
      threadID,
      (err) => {
        if (err) {
          console.error("[SALA] Send error:", err);
        }

        // পাঠানো শেষ হলে অস্থায়ী ফাইল পরিষ্কার
        fs.remove(outputPath).catch(() => {});
      },
      messageID
    );
  } catch (error) {
    console.error(
      "[SALA V2 ERROR]",
      error.response?.status || "",
      error.message
    );

    if (outputPath) {
      await fs.remove(outputPath).catch(() => {});
    }

    let reason = "ব্যানার তৈরি করা যায়নি।";

    if (error.code === "MODULE_NOT_FOUND") {
      reason =
        "প্রয়োজনীয় মডিউল পাওয়া যায়নি। canvas, axios ও fs-extra ইনস্টল করো।";
    } else if (
      error.response ||
      /image|decode|unsupported|format/i.test(error.message)
    ) {
      reason =
        "Template বা Avatar লোড হয়নি। ছবির URL এবং সার্ভারের নেটওয়ার্ক পরীক্ষা করো।";
    }

    return api.sendMessage(
      `❌ SALA ERROR\n\n${reason}\n\n` +
      `বিস্তারিত: ${error.message}`,
      threadID,
      messageID
    );
  }
};
